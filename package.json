{
  "name": "RapidRecap",
  "version": "2.0.8",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "jest",
    "build": "npm install",
    "server": "node app.js",
    "client": "npm start --prefix client",
    "clientinstall": "npm install --prefix client",
    "dev-mac": "concurrently \"npm run setup-pyenv-mac\" \"npm run start-dev-mac\"",
    "dev-win": "concurrently \"npm run setup-pyenv-win\" \"npm run start-dev-win\"",
    "setup-pyenv-win": "py -m venv venv && venv\\Scripts\\pip install -r requirements.txt && venv\\Scripts\\pip install setuptools && venv\\Scripts\\python -m playwright install chromium && venv\\Scripts\\python -c \"import nltk; nltk.download('punkt'); nltk.download('stopwords')\"",
    "setup-pyenv-mac": "python3 -m venv venv && source venv/bin/activate && pip install -r requirements.txt && pip install setuptools && python3 -m playwright install chromium && python3 -c \"import nltk; nltk.download('punkt'); nltk.download('stopwords')\"",
    "start-dev-win": "venv\\Scripts\\activate && nodemon app.js",
    "start-dev-mac": "source venv/bin/activate && nodemon --ignore 'venv/' app.js",
    "start": "npm run start-prod",
    "start-prod": "/opt/venv/bin/activate && node app.js"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "async-mutex": "^0.5.0",
    "axios": "^1.7.2",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "concurrently": "^8.2.2",
    "connect-s4a": "git+https://github.com/Saransh-mittal/connect-s4a.git#master",
    "cookie-parser": "^1.4.6",
    "crypto-js": "^4.2.0",
    "csrf": "^3.1.0",
    "dotenv": "^16.2.0",
    "express": "^4.18.2",
    "express-async-handler": "^1.2.0",
    "express-rate-limit": "^7.4.0",
    "express-session": "^1.18.1",
    "google-auth-library": "^9.7.0",
    "helmet": "^7.1.0",
    "html-entities": "^2.5.2",
    "i18next": "^23.14.0",
    "i18next-fs-backend": "^2.3.2",
    "i18next-http-middleware": "^3.6.0",
    "ioredis": "^5.4.1",
    "json2csv": "^6.0.0-alpha.2",
    "jsonwebtoken": "^9.0.0",
    "langdetect": "^0.2.1",
    "memory-cache": "^0.2.0",
    "moment": "^2.30.1",
    "moment-timezone": "^0.5.45",
    "mongoose": "^8.4.1",
    "natural": "^6.10.4",
    "newsapi": "^2.4.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.7",
    "nodemon": "^3.0.1",
    "object-sizeof": "^2.6.5",
    "openai": "^4.26.1",
    "path": "^0.12.7",
    "path-to-regexp": "^8.2.0",
    "prerender": "^5.21.6",
    "prerender-node": "^3.8.0",
    "slugify": "^1.6.6",
    "socket.io": "^4.7.5",
    "web-push": "^3.6.7",
    "xmlbuilder": "^15.1.1"
  }
}
