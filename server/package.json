{
  "name": "Rapid Recap",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "mocha",
    "build": "npm i",
    "start": "nodemon app.js",
    "server": "node app.js",
    "client": "npm start --prefix client",
    "clientinstall": "npm install --prefix client",
    "dev-mac": "concurrently \"npm run setup-pyenv-mac\" \"npm run start-dev-mac\"",
    "dev-win": "concurrently \"npm run setup-pyenv-win\" \"npm run start-dev-win\"",
    "setup-pyenv-win": "py -m venv venv && venv\\Scripts\\pip install -r requirements.txt",
    "setup-pyenv-mac": "python3 -m venv venv && source venv/bin/activate && pip install -r requirements.txt",
    "start-dev-win": "venv\\Scripts\\activate && nodemon app.js",
    "start-dev-mac": "source venv/bin/activate && nodemon app.js"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.7.1",
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.2",
    "child_process": "^1.0.2",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "crypto": "^1.0.1",
    "crypto-js": "^4.2.0",
    "dotenv": "^16.2.0",
    "express": "^4.18.2",
    "express-async-handler": "^1.2.0",
    "google-auth-library": "^9.7.0",
    "helmet": "^7.1.0",
    "html-entities": "^2.5.2",
    "i18next": "^23.14.0",
    "i18next-fs-backend": "^2.3.2",
    "i18next-http-middleware": "^3.6.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.0",
    "memory-cache": "^0.2.0",
    "moment": "^2.30.1",
    "moment-timezone": "^0.5.45",
    "natural": "^6.10.4",
    "newsapi": "^2.4.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.7",
    "nodemon": "^3.0.1",
    "openai": "^4.26.1",
    "path": "^0.12.7",
    "slugify": "^1.6.6",
    "socket.io": "^4.7.5",
    "web-push": "^3.6.7",
    "xmlbuilder": "^15.1.1"
  },
